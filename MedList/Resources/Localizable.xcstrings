    "Generated on %@": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemaakt op %@"
          }
        }
      }
    },
    "Has a flag": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft een aandachtspunt"
          }
        }
      }
    },
    "How often": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe vaak"
          }
        }
      }
    },
    "I agree that MedList processes health information about the person I care for, as described above, and I am allowed to do so for them.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ga ermee akkoord dat MedList gezondheidsgegevens verwerkt van de persoon voor wie ik zorg, zoals hierboven beschreven, en ik mag dit namens die persoon doen."
          }
        }
      }
    },
    "I understand MedList is an organizer and does not give medical advice.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik begrijp dat MedList een hulpmiddel om te ordenen is en geen medisch advies geeft."
          }
        }
      }
    },
    "If online reading is turned on in Settings: the text read from a label, with names, dates of birth and ID numbers removed where possible, is sent to the MedList extraction service and processed by an AI provider. It is not stored there.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als online lezen aan staat in Instellingen: de tekst van een etiket, waar mogelijk zonder namen, geboortedata en ID-nummers, wordt naar de MedList-uitleesdienst gestuurd en verwerkt door een AI-aanbieder. Daar wordt niets bewaard."
          }
        }
      }
    },
    "Ingredient lookup": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkzame stoffen opzoeken"
          }
        }
      }
    },
    "Interaction check unavailable": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle op wisselwerkingen niet beschikbaar"
          }
        }
      }
    },
    "Interaction data": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegevens over wisselwerkingen"
          }
        }
      }
    },
    "Interaction data: %@": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegevens over wisselwerkingen: %@"
          }
        }
      }
    },
    "Label reading": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiket lezen"
          }
        }
      }
    },
    "Labels are read on this device only. Online reading is not set up in this version.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketten worden alleen op dit toestel gelezen. Online lezen is in deze versie niet ingesteld."
          }
        }
      }
    },
    "List continues: %lld more medications are not shown. See the app.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "List continues: %lld more medication is not shown. See the app."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "List continues: %lld more medications are not shown. See the app."
                }
              }
            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "De lijst gaat verder: nog %lld medicijn staat niet op deze pagina. Zie de app."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "De lijst gaat verder: nog %lld medicijnen staan niet op deze pagina. Zie de app."
                }
              }
            }
          }
        }
      }
    },
    "Lock with %@": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrendelen met %@"
          }
        }
      }
    },
    "MedList helps you keep a single, up-to-date list of medications for the person you care for, and bring it to appointments.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "MedList helpt u één actuele medicijnlijst bij te houden voor de persoon voor wie u zorgt, en die bij afspraken bij de hand te hebben."
          }
        }
      }
    },
    "MedList is locked": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "MedList is vergrendeld"
          }
        }
      }
    },
    "Medication": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicijn"
          }
        }
      }
    },
    "Medication %lld of %lld": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicijn %1$lld van %2$lld"
          }
        }
      }
    },
    "Medication information is health data. Before you continue, please read how MedList handles it.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informatie over medicijnen is gezondheidsinformatie. Lees eerst hoe MedList daarmee omgaat."
          }
        }
      }
    },
    "Medication list": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicijnlijst"
          }
        }
      }
    },
    "Medication list – bring to appointment": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicijnlijst – voor de afspraak"
          }
        }
      }
    },
    "Medication name": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naam van het medicijn"
          }
        }
      }
    },
    "Medication names are looked up in RxNorm (US National Library of Medicine) to find active ingredients. No personal details are sent.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen van medicijnen worden opgezocht in RxNorm (Amerikaanse National Library of Medicine) om de werkzame stoffen te vinden. Er worden geen persoonsgegevens verstuurd."
          }
        }
      }
    },
    "Medications (%lld)": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicijnen (%lld)"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naam"
          }
        }
      }
    },
    "Names not recognized": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet herkende namen"
          }
        }
      }
    },
    "No flags found": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen aandachtspunten gevonden"
          }
        }
      }
    },
    "No medication details were found. Try a sharper photo, or add the medication by hand.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen medicijngegevens gevonden. Probeer een scherpere foto, of voeg het medicijn zelf toe."
          }
        }
      }
    },
    "No medications yet": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen medicijnen"
          }
        }
      }
    },
    "Nothing from this scan will be saved.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets van deze scan wordt bewaard."
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "One accurate medication list": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén kloppende medicijnlijst"
          }
        }
      }
    },
    "Online label reading": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiket online lezen"
          }
        }
      }
    },
    "Online reading was unavailable, so the text was read on this device only.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Online lezen was niet beschikbaar, dus de tekst is alleen op dit toestel gelezen."
          }
        }
      }
    },
    "Photograph a pill bottle label, a pharmacy box, or the medication list from discharge papers. Make sure the text is sharp and well lit.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografeer het etiket van een potje of doosje, of de medicijnlijst uit de ontslagpapieren. Zorg dat de tekst scherp en goed verlicht is."
          }
        }
      }
    },
    "Photos. They are read on this device and never stored or uploaded.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto's. Ze worden op dit toestel gelezen en nooit bewaard of geüpload."
          }
        }
      }
    },
    "Please check this value. It may not have been read correctly.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer deze waarde. Die is mogelijk niet goed gelezen."
          }
        }
      }
    },
