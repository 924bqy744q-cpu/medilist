        }
      }
    },
    "See items to verify with the pharmacist": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie wat u met de apotheker kunt controleren"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instellingen"
          }
        }
      }
    },
    "Share PDF": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF delen"
          }
        }
      }
    },
    "Share a one-page PDF": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel een PDF van één pagina"
          }
        }
      }
    },
    "Show recognized text": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkende tekst tonen"
          }
        }
      }
    },
    "Shown on the PDF so the doctor knows whose list it is. Stored only on this device.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat op de PDF zodat de arts weet van wie de lijst is. Alleen op dit toestel bewaard."
          }
        }
      }
    },
    "Shows the flags": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont de aandachtspunten"
          }
        }
      }
    },
    "Start": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen"
          }
        }
      }
    },
    "Strength": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sterkte"
          }
        }
      }
    },
    "Text is read on this device. Photos are never stored or uploaded.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst wordt op dit toestel gelezen. Foto's worden nooit bewaard of geüpload."
          }
        }
      }
    },
    "The PDF could not be created.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PDF kon niet worden gemaakt."
          }
        }
      }
    },
    "The medication list and care recipient will be permanently removed from this device.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De medicijnlijst en de zorgontvanger worden definitief van dit toestel verwijderd."
          }
        }
      }
    },
    "The medication list, the name and date of birth. Encrypted by iOS and not included in backups.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De medicijnlijst, de naam en de geboortedatum. Versleuteld door iOS en niet in back-ups opgenomen."
          }
        }
      }
    },
    "The photo could not be read. Please try again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto kon niet worden gelezen. Probeer het opnieuw."
          }
        }
      }
    },
    "The photo itself is not stored. This text is discarded when you leave this screen.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto zelf wordt niet bewaard. Deze tekst verdwijnt als u dit scherm verlaat."
          }
        }
      }
    },
    "Turn on the app lock": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app-vergrendeling aanzetten"
          }
        }
      }
    },
    "Unlock": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendelen"
          }
        }
      }
    },
    "Unlock the medication list": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De medicijnlijst ontgrendelen"
          }
        }
      }
    },
    "Use camera": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera gebruiken"
          }
        }
      }
    },
    "Use sample label": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorbeeldetiket gebruiken"
          }
        }
      }
    },
    "What leaves this device": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat dit toestel verlaat"
          }
        }
      }
    },
    "What stays on this device": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat op dit toestel blijft"
          }
        }
      }
    },
    "When on, recognized label text (not the photo) is sent to the MedList extraction service for better results. Names, dates of birth and ID numbers are removed first where possible.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dit aan staat, wordt de herkende tekst (niet de foto) naar de MedList-uitleesdienst gestuurd voor betere resultaten. Namen, geboortedata en ID-nummers worden waar mogelijk eerst verwijderd."
          }
        }
      }
    },
    "Who is this list for?": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor wie is deze lijst?"
          }
        }
      }
    },
    "You can delete all data at any time in Settings.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt alle gegevens altijd wissen in Instellingen."
          }
        }
      }
    },
    "device passcode": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "toegangscode"
          }
        }
      }
    },
    "e.g. 1 tablet": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bijv. 1 tablet"
          }
        }
      }
    },
    "e.g. 50 mg": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bijv. 50 mg"
          }
        }
      }
    },
    "e.g. Dr. Jansen": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bijv. Dr. Jansen"
          }
        }
      }
    },
    "e.g. Metoprolol": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bijv. Metoprolol"
          }
        }
      }
    },
    "e.g. blood pressure": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bijv. bloeddruk"
          }
        }
      }
    },
    "e.g. once daily": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bijv. 1 x per dag"
          }
        }
