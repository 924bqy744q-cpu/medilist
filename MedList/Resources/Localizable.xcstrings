    "Removes the care recipient, every medication, and all settings from this device. This cannot be undone.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert de zorgontvanger, alle medicijnen en alle instellingen van dit toestel. Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
