        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveelheid per keer"
          }
        }
      }
    },
    "Asks for Face ID or the device passcode each time MedList is opened.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraagt om Face ID of de toegangscode van het toestel telkens als MedList wordt geopend."
          }
        }
      }
    },
    "Care recipient": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorgontvanger"
