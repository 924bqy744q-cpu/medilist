      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicijn bewerken"
          }
        }
      }
    },
    "Entered and checked by the caregiver. Please compare with your own records.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingevoerd en gecontroleerd door de mantelzorger. Vergelijk dit met uw eigen gegevens."
          }
        }
      }
    },
