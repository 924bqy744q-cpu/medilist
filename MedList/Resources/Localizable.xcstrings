        }
      }
    },
    "Check and correct every detail": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer en verbeter elk gegeven"
          }
        }
      }
    },
    "Check every field against the label. Fields marked Check may have been read incorrectly.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijk elk veld met het etiket. Velden met Controleren zijn mogelijk niet goed gelezen."
          }
        }
      }
    },
