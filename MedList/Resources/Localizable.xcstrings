    "A medication name is needed.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een naam van het medicijn is nodig."
          }
        }
      }
    },
    "A one-page summary to bring to appointments. Check it before sharing.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een overzicht van één pagina voor afspraken. Controleer het voordat u het deelt."
          }
        }
      }
    },
