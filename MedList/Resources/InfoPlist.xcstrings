    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MedList uses the camera to read medication labels. Photos stay on this device."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "MedList gebruikt de camera om etiketten van medicijnen te lezen. Foto's blijven op dit toestel."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MedList can use Face ID to keep the medication list private."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "MedList kan Face ID gebruiken om de medicijnlijst privé te houden."
          }
        }
      }
    }
  }
